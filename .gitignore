.env
.env.local
.DS_Store
node_modules

# Fetched from jsDelivr by scripts/fetch-sdk.mjs (npm install / npm run fetch-sdk) — never committed.
vendor/

# Backup written by server/provision.mjs before overwriting server/agent.json — that file
# itself IS committed (see .github/workflows/redeploy.yml): its ids aren't secrets, and CI
# needs them on disk to redeploy with --reuse/--agent-id/--avatar-id instead of minting new
# live resources every run.
server/agent.json.bak

# Eval run output — always regenerated, never source (see docs/REFERENCE.md).
tests/eval/artifacts/
