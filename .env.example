# Required — from Kaltura's Rich Media CMS -> Settings -> Integration Settings.
AGENTIC_PARTNER_ID=
AGENTIC_ADMIN_SECRET=

# Optional — override the docs-site checkout that provision.mjs, the eval suite,
# and the dashboard all read src/**/*.md and src/_data/nav.js from. Defaults to
# a hardcoded sibling-checkout path meant for one maintainer's machine, so set
# this to wherever you've cloned the gh-pages-src branch of
# kaltura/intelligent-agents-sdk. See docs/GETTING-STARTED.md.
SITE_REPO_DIR=

# Optional — override the conversation backend the eval talks to (the
# Management client behind the stream transport and dashboard, and the
# chat transport's KalturaChatSession). Defaults to production
# (https://genie.nvp1.ovp.kaltura.com); only needed against a non-default
# environment.
AGENTIC_GENIE_URL=

# Optional — port for `npm run eval:dashboard`. Defaults to 8093.
NOVA_DASHBOARD_PORT=

# Optional — SDK git tag that `npm run fetch-sdk` (and `npm install`'s postinstall)
# vendors into vendor/sdk/. Defaults to the tag pinned in scripts/fetch-sdk.mjs.
SDK_TAG=
